# Viper488 Symbiotic VISA, for a machine with no seat (WSL, a headless lab machine): every account
# may open the devices 70-symbiotic.rules marks, not only the user at the seat. Any account then can
# drive the instruments, or load firmware into a blank 82357B.
# Installed by `linux/install-udev.sh --everyone`, or by the .deb on WSL and when upgrading a machine
# that had it before.

SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{SYMBIOTIC_DEVICE}=="1", MODE="0666"
SUBSYSTEM=="usbmisc", KERNEL=="usbtmc*", MODE="0666"
